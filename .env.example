# 复制为 .env.local 后填写。所有变量只在服务端读取，不会发送到浏览器。

# ── 模型接入（两项都填写才会退出演示模式）────────────────
# 任意 OpenAI 兼容的中转或官方地址，需包含 /v1
CYTRA_API_BASE_URL=
CYTRA_API_KEY=

# 可选：把站内模型 ID 映射到上游真实模型名（JSON）
# 可用的 ID：cytra-bio, gpt, claude, gemini, deepseek, qwen
# CYTRA_MODEL_MAP={"cytra-bio":"your-bio-finetune","gpt":"gpt-4.1","deepseek":"deepseek-chat"}

# ── 询价单投递 ────────────────────────────────────────
# 可选：询价提交后以 JSON POST 到这个地址（如飞书/企业微信机器人中转、CRM Webhook）
# 留空时只在服务端日志记录（不含联系方式）
INQUIRY_WEBHOOK_URL=

# ── 限流与超时 ────────────────────────────────────────
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_INQUIRY_PER_HOUR=10
UPSTREAM_TIMEOUT_MS=90000

# ── 站点 ──────────────────────────────────────────────
# 用于 sitemap、OG 图等绝对地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
